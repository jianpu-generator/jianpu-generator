# Local-dev-only values, loaded automatically by `wrangler dev` (never used
# against real Cloudflare/GitHub). Not a real secret -- deliberately
# committed so `pnpm test:e2e:resolve` works out of the box for anyone
# checking out this repo, per `web/playwright.config.ts`'s Synced Share
# worker webServer entry (task 11,
# `TODO-synced-share-rust-d1-migration.md`). `SYNCED_SHARE_GITHUB_CLIENT_SECRET`
# must be present for `crates/live-share-worker/src/oauth.rs`'s
# `ctx.secret(CLIENT_SECRET_BINDING)` to resolve at all; its value is never
# actually checked against anything real, since e2e also overrides
# `SYNCED_SHARE_GITHUB_TOKEN_URL`/`SYNCED_SHARE_GITHUB_USER_URL` (via
# `--var`, see `playwright.config.ts`) to point at
# `web/e2e/mock-github-oauth-server.mjs` instead of real GitHub.
SYNCED_SHARE_GITHUB_CLIENT_ID=e2e-test-client-id
SYNCED_SHARE_GITHUB_CLIENT_SECRET=e2e-test-client-secret
