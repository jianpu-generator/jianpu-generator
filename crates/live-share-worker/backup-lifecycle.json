{
  "rules": [
    {
      "id": "expire-daily-after-30-days",
      "enabled": true,
      "conditions": { "prefix": "daily/" },
      "deleteObjectsTransition": { "condition": { "type": "Age", "maxAge": 2592000 } }
    },
    {
      "id": "expire-monthly-after-365-days",
      "enabled": true,
      "conditions": { "prefix": "monthly/" },
      "deleteObjectsTransition": { "condition": { "type": "Age", "maxAge": 31536000 } }
    }
  ]
}
