# Shared dev/e2e defaults, matching what .github/workflows/pages.yml sets
# for CI builds. Not secrets:
# - VITE_GITHUB_OAUTH_CLIENT_ID is functionally unused by the proxy, which
#   injects the real GITHUB_CLIENT_ID server-side regardless of what's sent
#   here — required only because @octokit/auth-oauth-device needs a
#   non-empty clientId to construct its requests.
# - VITE_SYNCED_SHARE_HOST is exposed client-side regardless of where it's set.
# Override locally via the gitignored .env.local if needed.
VITE_GITHUB_OAUTH_CLIENT_ID=placeholder-client-id
VITE_GITHUB_OAUTH_PROXY_URL=https://jianpu-oauth-proxy.pages.dev
VITE_SYNCED_SHARE_HOST=jianpu-live.hou32hou.workers.dev
