{
  "name": "jianpu-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build:wasm-component": "cargo component build --manifest-path ../crates/jianpu-wasm/Cargo.toml --profile release-wasm --no-default-features --features wav,mp3,pdf,midi --target wasm32-unknown-unknown && jco transpile ../target/wasm32-unknown-unknown/release-wasm/jianpu_wasm.wasm --instantiation async -o ../crates/jianpu-wasm/pkg-component",
    "predev": "pnpm run build:wasm-component",
    "dev": "vite",
    "prebuild": "pnpm run build:wasm-component",
    "build": "tsc -b && vite build",
    "check": "knip --include files,dependencies",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ast-grep": "ast-grep scan --config sgconfig.yml src",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test:e2e:resolve": "node scripts/resolve-e2e-flakes.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@github/hotkey": "^3.1.4",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/auth-oauth-device": "^8.0.3",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.10",
    "lucide-react": "^1.21.0",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.55.1",
    "partysocket": "^1.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.39.0",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.3",
    "@biomejs/biome": "^2.4.16",
    "@bytecodealliance/jco": "^1.32.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "knip": "^6.16.1",
    "playwright-bdd": "^9.2.0",
    "typescript": "~7.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ast-grep/cli",
      "esbuild"
    ]
  }
}
