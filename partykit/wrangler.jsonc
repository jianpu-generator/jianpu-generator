{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "jianpu-live",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  // v1 created the `LiveShareServer` Durable Object class; v2 decommissions
  // it now that the room is plain KV (see `src/index.ts`) — a deletion
  // migration is required to remove a class that had SQLite storage, it
  // can't just be dropped from the config.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveShareServer"] },
    { "tag": "v2", "deleted_classes": ["LiveShareServer"] },
  ],
  "kv_namespaces": [{ "binding": "SHARES", "id": "ddb96def92b54f6ea9d0426d71a899ec" }],
}
